{
  "name": "furrbox-desktop",
  "productName": "FurrBox",
  "version": "2.0.19",
  "private": true,
  "description": "FurrBox Desktop – Electron-App mit eingebautem FurrBox-Server.",
  "main": "main.cjs",
  "scripts": {
    "build:server": "node build-server.mjs",
    "start": "node build-server.mjs && electron .",
    "start:fast": "electron .",
    "dist": "node build-server.mjs && electron-builder --win nsis portable",
    "release": "node build-server.mjs && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.furrbox.desktop",
    "productName": "FurrBox",
    "files": [
      "main.cjs",
      "preload.cjs",
      "vrchat.cjs",
      "vrchat-log.cjs",
      "splash.html",
      "setup.html",
      "package.json",
      "vr-overlay.cjs",
      "openvr-tables.json",
      "osc.cjs",
      "media.cjs",
      "media.ps1"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "discord.json"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FurrBox-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "FurrBox-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "shortcutName": "FurrBox",
      "uninstallDisplayName": "FurrBox"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kitsulife2601",
        "repo": "furrbox",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  }
}

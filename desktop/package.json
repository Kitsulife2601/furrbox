{
  "name": "furrbox-desktop",
  "productName": "FurrBox",
  "version": "2.0.9",
  "private": true,
  "description": "FurrBox Desktop – Electron-App mit eingebautem FurrBox-Server.",
  "main": "main.cjs",
  "scripts": {
    "build:server": "node build-server.mjs",
    "start": "node build-server.mjs && electron .",
    "start:fast": "electron .",
    "dist": "node build-server.mjs && electron-builder --win nsis portable",
    "release": "node build-server.mjs && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.furrbox.desktop",
    "productName": "FurrBox",
    "files": [
      "main.cjs",
      "preload.cjs",
      "vrchat.cjs",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "discord.json"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FurrBox-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "FurrBox-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "include": "build/installer.nsh",
      "shortcutName": "FurrBox",
      "uninstallDisplayName": "FurrBox"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kitsulife2601",
        "repo": "furrbox",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

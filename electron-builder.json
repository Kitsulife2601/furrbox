{
  "appId": "de.furrbox.desktop.standard",
  "productName": "FurrBox Standard",
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "frontend/out",
      "to": "frontend/out"
    }
  ],
  "directories": {
    "output": "release"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "FurrBox_${env.FURRBOX_EDITION}_Setup.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "http://5.249.162.130:4000/updates/${env.FURRBOX_UPDATE_CHANNEL}"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}

# Kopiere diese Datei nach backend/.env und passe die Werte an (wird nicht zu GitHub hochgeladen).
# Passwort fuer den Entwickler-Account "Kitsulife" (wird bei jedem Start gesetzt).
FURRBOX_ADMIN_PASSWORD=replace-this-with-your-own-password
# Adresse, unter der andere diesen Server erreichen (z. B. Tailscale-IP).
# FURRBOX_SERVER_URL=http://100.x.y.z:4000

PORT=4000
STORAGE_DIR=./storage
DATABASE_URL=file:./storage/furrbox.db
JWT_SECRET=replace-this-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3300

FURRBOX_BACKEND_URL=http://localhost:4000
BOT_BRIDGE_TOKEN=replace-this-with-the-same-long-random-bridge-secret
DISCORD_TOKEN=put-your-discord-bot-token-here
DISCORD_GUILD_ID=put-your-discord-server-id-here
DISCORD_MUTED_ROLE_ID=
DISCORD_MUTED_ROLE_NAME=Muted

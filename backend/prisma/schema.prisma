generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FileScope {
  PRIVATE
  PUBLIC
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  displayName  String
  createdAt    DateTime     @default(now())
  files        StoredFile[]
}

model StoredFile {
  id           String    @id @default(uuid())
  name         String
  originalName String
  size         Int
  mimeType     String
  scope        FileScope
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedAt   DateTime  @default(now())

  @@index([scope])
  @@index([ownerId])
}

model DiscordMember {
  discordId        String   @id
  username         String
  displayName      String
  rolesJson        String
  highestPrivilege String
  isSupporter      Boolean  @default(false)
  isModerator      Boolean  @default(false)
  isOwner          Boolean  @default(false)
  isDev            Boolean  @default(false)
  syncedAt         DateTime @updatedAt

  @@index([highestPrivilege])
}

model DiscordWarning {
  id          String   @id @default(uuid())
  targetId    String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([targetId])
  @@index([moderatorId])
}

model ModerationAudit {
  id          String   @id @default(uuid())
  requestId   String?
  source      String
  action      String
  moderatorId String
  targetId    String
  reason      String
  durationMs  Int?
  status      String
  error       String?
  createdAt   DateTime @default(now())

  @@index([requestId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FileScope {
  PRIVATE
  PUBLIC
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  displayName  String
  discordId    String?      @unique
  createdAt    DateTime     @default(now())
  files        StoredFile[]
  presence     UserPresence?
}

model UserPresence {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordId       String?
  status          String    @default("offline")
  socketId        String?
  connectedAt     DateTime?
  lastHeartbeatAt DateTime?
  lastSeenAt      DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([discordId])
}

model StoredFile {
  id           String    @id @default(uuid())
  name         String
  originalName String
  size         Int
  mimeType     String
  scope        FileScope
  ownerId      String?
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedAt   DateTime  @default(now())

  @@index([scope])
  @@index([ownerId])
}

model DiscordMember {
  discordId        String   @id
  username         String
  nickname         String?
  displayName      String
  rolesJson        String
  roleNamesJson    String   @default("[]")
  highestPrivilege String
  discordStatus    String   @default("offline")
  isDiscordOnline  Boolean  @default(false)
  lastDiscordPresenceAt DateTime?
  isSupporter      Boolean  @default(false)
  isModerator      Boolean  @default(false)
  isOwner          Boolean  @default(false)
  isDev            Boolean  @default(false)
  syncedAt         DateTime @updatedAt

  @@index([highestPrivilege])
  @@index([discordStatus])
}

model DiscordWarning {
  id          String   @id @default(uuid())
  targetId    String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([targetId])
  @@index([moderatorId])
}

model ModerationAudit {
  id          String   @id @default(uuid())
  requestId   String?
  source      String
  action      String
  moderatorId String
  targetId    String
  reason      String
  durationMs  Int?
  status      String
  error       String?
  createdAt   DateTime @default(now())

  @@index([requestId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([createdAt])
}
